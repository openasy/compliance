{
  "openapi": "3.1.1",
  "info": {
    "title": "OpenAsy Compliance API",
    "version": "0.1.0",
    "summary": "ISO 27001, SOC 2, GDPR and PCI DSS controls, with evidence read from the products that do the work.",
    "description": "Every screen of compliance uses this API, and so can your scripts (ADR 0014). Within `/api/v1` changes are additive only; anything removed is deprecated first (ADR 0024). Errors use Problem Details (RFC 9457).\n\nCompliance reads the other products' `/metrics` and judges checks on what they serve; nothing is sent to it. Every operation takes the session of a signed-in person or an API token, and names the role it needs (`x-openasy-role`: viewer, editor, admin; ADR 0003).\n\nSign-in, members and API tokens are under `/api/v1/auth`, provided by [@openasy/auth](https://github.com/openasy/auth#routes).",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/",
      "description": "This compliance"
    }
  ],
  "tags": [
    {
      "name": "Frameworks",
      "description": "ISO 27001, SOC 2, GDPR and PCI DSS, and their reports."
    },
    {
      "name": "Controls",
      "description": "Each control's state, owner and evidence."
    },
    {
      "name": "Checks",
      "description": "Numbers read from the products, and what they must be."
    },
    {
      "name": "Product",
      "description": "Version and overview of this compliance."
    }
  ],
