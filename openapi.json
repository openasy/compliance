  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-openasy-session",
        "description": "The browser session after signing in (`openasy-session` when compliance runs on plain http://localhost). Requests that change something must come from the compliance origin."
      },
      "apiToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "An API token created under Settings → API tokens (`oa_compliance_...`): one role, always an expiry (ADR 0003)."
      },
      "adminToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Only when compliance is started by its tests or a local script: one shared token with the admin role. A production install does not have it."
      }
    },
    "responses": {
      "Problem": {
        "description": "An error, as RFC 9457 Problem Details.",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "code": {
            "type": "string",
            "enum": [
              "invalid-token",
              "invalid-json",
              "invalid-body",
              "conflict",
              "not-found",
              "not-configured",
              "internal-error",
              "unauthenticated",
              "invalid-credentials",
              "mfa-required",
              "mfa-setup-required",
              "forbidden",
              "cross-site",
              "rate-limited"
            ],
            "description": "Stable; match on this."
          },
          "detail": {
            "type": "string"
          }
        }
      },
      "ProductLink": {
        "type": "object",
        "required": [
          "id",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "The product, as OpenAsy names it.",
            "examples": [
              "infrastructure"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "The address people open it at.",
            "examples": [
              "https://infra.example.com"
            ]
          }
        }
      },
      "ProductList": {
        "type": "object",
        "required": [
          "products"
        ],
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProductLink"
            }
          }
        }
      },
      "Status": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Version": {
        "type": "object",
        "required": [
          "product",
          "version"
        ],
        "properties": {
          "product": {
            "const": "compliance"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Tally": {
        "type": "object",
        "required": [
          "controls",
          "passing",
          "failing",
          "needsEvidence",
          "notApplicable"
        ],
        "properties": {
          "controls": {
            "type": "integer"
          },
          "passing": {
            "type": "integer"
          },
          "failing": {
            "type": "integer"
          },
          "needsEvidence": {
            "type": "integer"
          },
          "notApplicable": {
            "type": "integer"
          }
        }
      },
      "Framework": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Tally"
          },
          {
            "type": "object",
            "required": [
              "id",
              "name",
              "enabled",
              "days"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "enabled": {
                "type": "boolean",
                "description": "Controls of a framework that is not enabled are left out of lists and the overview."
              },
              "days": {
                "type": "array",
                "description": "The last 90 days: controls passing of those that apply.",
                "items": {
                  "type": "object",
                  "required": [
                    "day",
                    "passing",
                    "total"
                  ],
                  "properties": {
                    "day": {
                      "type": "string",
                      "format": "date"
                    },
                    "passing": {
                      "type": "integer"
                    },
                    "total": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "FrameworkList": {
        "type": "object",
        "required": [
          "frameworks"
        ],
        "properties": {
          "frameworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Framework"
            }
          }
        }
      },
      "EnableFramework": {
        "type": "object",
        "required": [
          "enabled"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          }
        }
      },
      "Gap": {
        "type": "object",
        "required": [
          "kind"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "failing",
              "no-data",
              "unreachable",
              "no-product",
              "evidence-missing",
              "evidence-expired"
            ],
            "description": "failing: a check fails; no-data: the product does not serve the number; unreachable: the product could not be read; no-product: no installed product proves it, add evidence; evidence-missing and evidence-expired: evidence by hand is needed."
          },
          "check": {
            "type": "string"
          }
        }
      },
      "ControlSummary": {
        "type": "object",
        "required": [
          "framework",
          "ref",
          "title",
          "state",
          "owner",
          "applicable",
          "reason",
          "manual",
          "checks",
          "evidence",
          "gaps"
        ],
        "properties": {
          "framework": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "passing",
              "failing",
              "needs-evidence",
              "not-applicable"
            ]
          },
          "owner": {
            "type": "string"
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "description": "Why it does not apply."
          },
          "manual": {
            "type": [
              "string",
              "null"
            ],
            "description": "Evidence a person must add, when software cannot prove the control."
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "product",
                "title",
                "state"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "product": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "pass",
                    "fail",
                    "no-data",
                    "unreachable",
                    "not-connected"
                  ]
                }
              }
            }
          },
          "evidence": {
            "type": "integer",
            "description": "Pieces of evidence added by hand, valid or not."
          },
          "gaps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Gap"
            }
          }
        }
      },
      "ControlList": {
        "type": "object",
        "required": [
          "controls"
        ],
        "properties": {
          "controls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ControlSummary"
            }
          }
        }
      },
      "Check": {
        "type": "object",
        "required": [
          "id",
          "product",
          "title",
          "expression",
          "state",
          "value",
          "at",
          "controls"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "product": {
            "type": "string",
            "description": "The product whose /metrics it reads."
          },
          "title": {
            "type": "string"
          },
          "expression": {
            "type": "string",
            "description": "What the number must be, such as openasy_vulns_known_exploited = 0."
          },
          "state": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "no-data",
              "unreachable",
              "not-connected"
            ]
          },
          "value": {
            "type": [
              "number",
              "null"
            ]
          },
          "at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "controls": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "framework",
                "ref"
              ],
              "properties": {
                "framework": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "CheckList": {
        "type": "object",
        "required": [
          "checks"
        ],
        "properties": {
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Check"
            }
          }
        }
      },
      "CheckDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Check"
          },
          {
            "type": "object",
            "required": [
              "days"
            ],
            "properties": {
              "days": {
                "type": "array",
                "description": "The last 90 days with a read: reads, reads that passed, and the last value.",
                "items": {
                  "type": "object",
                  "required": [
                    "day",
                    "runs",
                    "passes",
                    "value"
                  ],
                  "properties": {
                    "day": {
                      "type": "string",
                      "format": "date"
                    },
                    "runs": {
                      "type": "integer"
                    },
                    "passes": {
                      "type": "integer"
                    },
                    "value": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "Evidence": {
        "type": "object",
        "required": [
          "id",
          "framework",
          "ref",
          "title",
          "url",
          "note",
          "validUntil",
          "valid",
          "addedBy",
          "addedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "framework": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          },
          "validUntil": {
            "type": "string",
            "format": "date"
          },
          "valid": {
            "type": "boolean"
          },
          "addedBy": {
            "type": "string"
          },
          "addedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "NewEvidence": {
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 200
          },
          "url": {
            "type": "string",
            "description": "Where the document is, such as your wiki or file share."
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "validUntil": {
            "type": "string",
            "format": "date",
            "description": "The last day it counts; a year from today when left out."
          }
        }
      },
      "Control": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ControlSummary"
          },
          {
            "type": "object",
            "required": [
              "frameworkName",
              "results",
              "evidenceItems"
            ],
            "properties": {
              "frameworkName": {
                "type": "string"
              },
              "results": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Check"
                }
              },
              "evidenceItems": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Evidence"
                }
              }
            }
          }
        ]
      },
      "UpdateControl": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "maxLength": 120
          },
          "applicable": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "description": "Needed when it does not apply."
          }
        }
      },
      "Source": {
        "type": "object",
        "required": [
          "product",
          "url",
          "state",
          "lastAt",
          "lastOkAt",
          "error",
          "checks"
        ],
        "properties": {
          "product": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "ok",
              "failing",
              "waiting"
            ]
          },
          "lastAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lastOkAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "checks": {
            "type": "integer"
          }
        }
      },
      "SourceList": {
        "type": "object",
        "required": [
          "sources"
        ],
        "properties": {
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Source"
            }
          }
        }
      },
      "Summary": {
        "type": "object",
        "required": [
          "frameworks",
          "totals",
          "withoutOwner",
          "sources",
          "evidence",
          "failingChecks",
          "lastCollectedAt"
        ],
        "properties": {
          "frameworks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Framework"
            },
            "description": "The enabled frameworks."
          },
          "totals": {
            "$ref": "#/components/schemas/Tally"
          },
          "withoutOwner": {
            "type": "integer"
          },
          "sources": {
            "type": "object",
            "required": [
              "total",
              "ok",
              "failing"
            ],
            "properties": {
              "total": {
                "type": "integer"
              },
              "ok": {
                "type": "integer"
              },
              "failing": {
                "type": "integer"
              }
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "total",
              "expiringSoon",
              "expired"
            ],
            "properties": {
              "total": {
                "type": "integer"
              },
              "expiringSoon": {
                "type": "integer"
              },
              "expired": {
                "type": "integer"
              }
            }
          },
          "failingChecks": {
            "type": "array",
            "description": "Failing checks, by how many controls they hold back.",
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "product",
                "controls"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "product": {
                  "type": "string"
                },
                "controls": {
                  "type": "integer"
                }
              }
            }
          },
          "lastCollectedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    }
  }
}
